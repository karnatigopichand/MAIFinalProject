{
  "openapi": "3.1.0",
  "info": {
    "title": "commerce-inventory HTTP API",
    "version": "0.1.0",
    "description": "Seeds absolute stock levels, aggregates duplicate SKU lines, checks all availability before decrementing, and stores a reservation. Implementation-reviewed supported contracts; runtime validation is partial. Configured servers are not verified deployments. Unknown routes return JSON 404 for GET/POST; unsupported methods use Python HTTP server HTML 501. GET storage failures are not normalized into a JSON error."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8002",
      "description": "Configured local listener; start process first."
    },
    {
      "url": "http://commerce-inventory:8002",
      "description": "Configured development hostname; dummy DNS, not a verified deployment."
    }
  ],
  "security": [
    {
      "CommerceBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "inventoryHealth",
        "summary": "Process liveness; no downstream check",
        "responses": {
          "200": {
            "description": "Process is serving HTTP; does not prove dependencies are healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "service": "commerce-inventory",
                  "status": "up",
                  "dependency_check": false
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "security": []
      }
    },
    "/stock/{id}": {
      "get": {
        "operationId": "inventoryRead",
        "summary": "Read one stock record",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Exact stored sku; use an unescaped safe identifier.",
            "schema": {
              "type": "string"
            },
            "example": "book"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored JSON record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                },
                "example": {
                  "quantity": 5
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "404": {
            "description": "No stored record or unmatched path.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_found"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token when authentication is enabled"
          }
        },
        "security": [
          {
            "CommerceBearer": []
          }
        ]
      }
    },
    "/reservations": {
      "post": {
        "operationId": "inventoryReserve",
        "summary": "Inventory reservations",
        "description": "Schemas describe the supported client contract; the runtime does not perform full schema validation. Existing IDs may return stored results before validating all fields.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteRequest"
              },
              "example": {
                "order_id": "demo-1",
                "items": [
                  {
                    "sku": "book",
                    "quantity": 1
                  }
                ]
              }
            }
          },
          "description": "JSON object; Content-Length must be 1–1048576 bytes. Content-Type application/json is recommended but not enforced. Chunked transfer is unsupported."
        },
        "responses": {
          "200": {
            "description": "Successful result, including sequential retries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResult"
                },
                "example": {
                  "order_id": "demo-1",
                  "status": "reserved",
                  "items": {
                    "book": 1
                  }
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "POST only: absent/zero/negative Content-Length, or declared length over 1,048,576 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_body_size"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "422": {
            "description": "POST: invalid JSON, non-object body, nonnumeric Content-Length, missing keys, ValueError/KeyError/TypeError, or business rejection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request_or_business_rejection"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "POST: otherwise uncaught exception, including broker receipt timeout or SQLite failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "dependency_or_storage_failure"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token when authentication is enabled"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "security": [
          {
            "CommerceBearer": []
          }
        ]
      }
    },
    "/stock": {
      "post": {
        "operationId": "inventorySeedStock",
        "summary": "Set absolute stock quantity",
        "description": "Schemas describe the supported client contract; the runtime does not perform full schema validation. Existing IDs may return stored results before validating all fields.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockWrite"
              },
              "example": {
                "sku": "book",
                "quantity": 5
              }
            }
          },
          "description": "JSON object; Content-Length must be 1–1048576 bytes. Content-Type application/json is recommended but not enforced. Chunked transfer is unsupported."
        },
        "responses": {
          "200": {
            "description": "Successful result, including sequential retries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockWriteResult"
                },
                "example": {
                  "sku": "book",
                  "quantity": 5
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "POST only: absent/zero/negative Content-Length, or declared length over 1,048,576 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_body_size"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "422": {
            "description": "POST: invalid JSON, non-object body, nonnumeric Content-Length, missing keys, ValueError/KeyError/TypeError, or business rejection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request_or_business_rejection"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "POST: otherwise uncaught exception, including broker receipt timeout or SQLite failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "dependency_or_storage_failure"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token when authentication is enabled"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "security": [
          {
            "CommerceBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LineItem": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock keeping unit, e.g. book"
          },
          "quantity": {
            "type": "integer",
            "description": "Positive whole number; booleans are rejected by inventory.",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true
      },
      "Resource": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "",
            "minimum": 0
          }
        },
        "required": [
          "quantity"
        ],
        "additionalProperties": true
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "const": "commerce-inventory"
          },
          "status": {
            "type": "string",
            "const": "up"
          },
          "dependency_check": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "service",
          "status",
          "dependency_check"
        ],
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": ""
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "WriteRequest": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": ""
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          }
        },
        "required": [
          "order_id",
          "items"
        ],
        "additionalProperties": true
      },
      "WriteResult": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": ""
          },
          "status": {
            "type": "string",
            "const": "reserved"
          },
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "SKU to summed quantity; duplicate input lines are aggregated."
          }
        },
        "required": [
          "order_id",
          "status",
          "items"
        ],
        "additionalProperties": true
      },
      "StockWrite": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": ""
          },
          "quantity": {
            "type": "integer",
            "description": "Absolute replacement quantity, not an increment.",
            "minimum": 0
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true
      },
      "StockWriteResult": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": ""
          },
          "quantity": {
            "type": "integer",
            "description": "",
            "minimum": 0
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Accepted but ignored by this implementation: not propagated or echoed. Outbound calls generate independent IDs.",
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "CommerceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque shared service token"
      }
    }
  },
  "externalDocs": {
    "url": "https://spec.openapis.org/oas/v3.1.0.html",
    "description": "OpenAPI format reference"
  },
  "x-source-files": [
    "src/commerce_inventory/app.py",
    "src/commerce_inventory/service.py",
    "src/commerce_inventory/runtime.py",
    "config/local.json",
    "config/development.json"
  ]
}
