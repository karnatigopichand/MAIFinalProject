{
  "endpoint": "POST /reservations",
  "calls": [],
  "publishes": [],
  "consumes": [],
  "mappings": {
    "items[].sku": "stock.sku",
    "items[].quantity": "stock.quantity"
  },
  "repository": "commerce-inventory",
  "logical_tables": [
    "stock",
    "reservations"
  ],
  "storage": "SQLite records(kind,key,payload), PRIMARY KEY(kind,key)",
