{
  "service": "commerce-inventory",
  "environment": "local",
  "server": {
    "host": "127.0.0.1",
    "port": 8002
  },
  "database": {
    "path": "data/inventory.sqlite"
  },
  "api": {
    "read_path": "/stock",
    "record_kind": "stock",
    "write_routes": {
      "/reservations": "reserve",
      "/stock": "seed_stock"
    }
  },
  "http": {},
  "mq": {
    "host": "127.0.0.1",
    "port": 61613,
    "tls": false,
    "username_env": "ACTIVEMQ_USERNAME",
    "password_env": "ACTIVEMQ_PASSWORD",
    "receipt_timeout_seconds": 5,
    "publish": {},
    "consume": {}
  }
}
