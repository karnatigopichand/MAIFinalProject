{
  "openapi": "3.1.0",
  "info": {
    "title": "commerce-shipping HTTP API",
    "version": "0.1.0",
    "description": "Consumes confirmed orders, calls an external carrier, stores tracking information, and publishes shipment creation. HTTP is read-only. Implementation-reviewed supported contracts; runtime validation is partial. Configured servers are not verified deployments. Unknown routes return JSON 404 for GET/POST; unsupported methods use Python HTTP server HTML 501. GET storage failures are not normalized into a JSON error."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8004",
      "description": "Configured local listener; start process first."
    },
    {
      "url": "http://commerce-shipping:8004",
      "description": "Configured development hostname; dummy DNS, not a verified deployment."
    }
  ],
  "security": [
    {
      "CommerceBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "shippingHealth",
        "summary": "Process liveness; no downstream check",
        "responses": {
          "200": {
            "description": "Process is serving HTTP; does not prove dependencies are healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "service": "commerce-shipping",
                  "status": "up",
                  "dependency_check": false
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "security": []
      }
    },
    "/shipments/{id}": {
      "get": {
        "operationId": "shippingRead",
        "summary": "Read one shipments record",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Exact stored order_id; use an unescaped safe identifier.",
            "schema": {
              "type": "string"
            },
            "example": "demo-1"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Stored JSON record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                },
                "example": {
                  "order_id": "demo-1",
                  "tracking_number": "TRACK-1"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "404": {
            "description": "No stored record or unmatched path.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_found"
                }
              }
            },
            "headers": {
              "Content-Length": {
                "description": "Length of encoded JSON response in bytes.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token when authentication is enabled"
          }
        },
        "security": [
          {
            "CommerceBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LineItem": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock keeping unit, e.g. book"
          },
          "quantity": {
            "type": "integer",
            "description": "Positive whole number; booleans are rejected by inventory.",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true
      },
      "Resource": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": ""
          },
          "tracking_number": {
            "type": "string",
            "description": "Returned by carrier."
          }
        },
        "required": [
          "order_id",
          "tracking_number"
        ],
        "additionalProperties": true
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "const": "commerce-shipping"
          },
          "status": {
            "type": "string",
            "const": "up"
          },
          "dependency_check": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "service",
          "status",
          "dependency_check"
        ],
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": ""
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Accepted but ignored by this implementation: not propagated or echoed. Outbound calls generate independent IDs.",
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "CommerceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque shared service token"
      }
    }
  },
  "externalDocs": {
    "url": "https://spec.openapis.org/oas/v3.1.0.html",
    "description": "OpenAPI format reference"
  },
  "x-source-files": [
    "src/commerce_shipping/app.py",
    "src/commerce_shipping/service.py",
    "src/commerce_shipping/runtime.py",
    "config/local.json",
    "config/development.json"
  ]
}
